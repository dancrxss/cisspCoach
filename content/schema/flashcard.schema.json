{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cissp-coach/flashcard",
  "title": "Flashcard",
  "type": "object",
  "required": ["id", "domain", "subdomain", "front", "back", "whyItMatters"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^f-d[1-8]-[a-z0-9]+-\\d{3,}$" },
    "domain": { "type": "integer", "minimum": 1, "maximum": 8 },
    "subdomain": { "type": "string", "pattern": "^[1-8]\\.\\d{1,2}$" },
    "front": { "type": "string", "minLength": 5 },
    "back": { "type": "string", "minLength": 5 },
    "whyItMatters": { "type": "string", "minLength": 10, "description": "one line on how the exam uses this fact" },
    "siblingOf": { "type": "string", "description": "id of a card this re-teaches from another angle (coaching loop output)" },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
