{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cissp-coach/question",
  "title": "Question",
  "type": "object",
  "required": ["id", "domain", "subdomain", "difficulty", "stem", "options", "correct", "ladder", "explanation"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^q-d[1-8]-[a-z0-9]+-\\d{3,}$", "description": "stable across packs, e.g. q-d1-risk-017" },
    "domain": { "type": "integer", "minimum": 1, "maximum": 8 },
    "subdomain": { "type": "string", "pattern": "^[1-8]\\.\\d{1,2}$", "description": "outline heading number, e.g. '1.9'" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
    "stem": { "type": "string", "minLength": 20 },
    "options": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "correct": { "type": "integer", "minimum": 0, "maximum": 3 },
    "ladder": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "items": { "type": "string", "minLength": 10 },
      "description": "Socratic guiding questions, revealed one at a time, leading toward the answer without stating it"
    },
    "explanation": {
      "type": "object",
      "required": ["correct", "distractors"],
      "additionalProperties": false,
      "properties": {
        "correct": { "type": "string", "minLength": 20, "description": "why the correct option is right" },
        "distractors": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["option", "why"],
            "additionalProperties": false,
            "properties": {
              "option": { "type": "integer", "minimum": 0, "maximum": 3 },
              "why": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "enum": ["manager-mindset", "definition", "scenario", "ordering", "best-answer", "calculation"] }
    },
    "reviewed": { "type": "boolean", "description": "passed the second-agent review gate" }
  }
}
